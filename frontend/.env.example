# SIH26099 Enterprise Frontend - Production Environment Variables Template
# On Render Static Site, configure these in the Environment tab:

# URL of the deployed Spring Boot Backend Web Service
# Example: https://cpse-backend.onrender.com/api (or https://cpse-backend.onrender.com)
VITE_API_URL=https://cpse-backend.onrender.com/api

# Optional: URL of the deployed Python FastAPI ML Microservice
# Example: https://cpse-ml-service.onrender.com
VITE_ML_API_URL=https://cpse-ml-service.onrender.com
